pkgname='control-me-git'
_srcname='control-me'
pkgdesc='Personal productivity application'
pkgver=r0.0000000
pkgrel=1
arch=('any')
url='https://github.com/Moses-Bejon/Control_Me'
license=('MIT')
depends=(
  'python'
  'python-pyqt6'
  'python-dotenv'
  'python-litellm'
  'python-ollama'
  'python-pyscreenshot'
)
makedepends=('git')
provides=('control-me')
conflicts=('control-me')
source=("${_srcname}::git+${url}.git")
b2sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_srcname}"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  local appdir="${pkgdir}/usr/lib/control-me"
  local source_root="${srcdir}/${_srcname}"
  local module

  install -d "${appdir}"
  install -Dm644 "${source_root}/main.py" "${appdir}/main.py"
  install -Dm644 "${source_root}/icon.ico" "${appdir}/icon.ico"
  while IFS= read -r -d '' module; do
    install -Dm644 "${module}" "${appdir}/${module#"${source_root}/"}"
  done < <(find "${source_root}/modules" -type f -name '*.py' -print0)

  install -Dm755 "${source_root}/package/archlinux/control-me" \
    "${pkgdir}/usr/bin/control-me"
  install -Dm644 "${source_root}/package/archlinux/control-me.desktop" \
    "${pkgdir}/usr/share/applications/control-me.desktop"
  install -Dm644 "${source_root}/package/archlinux/control-me.service" \
    "${pkgdir}/usr/lib/systemd/user/control-me.service"
  install -Dm644 "${source_root}/icon.png" \
    "${pkgdir}/usr/share/pixmaps/control-me.png"
}
